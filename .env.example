# llama-server must remain bound to loopback. Router presets and autoload are
# host-owned; see docs/operations/amd-pilot-host-setup.md.
LLAMA_SERVER_URL=http://127.0.0.1:8080

# Account persistence defaults to ./data/good-enough.sqlite.
GOOD_ENOUGH_DATABASE_PATH=./data/good-enough.sqlite

# Public member registration is open unless explicitly closed.
ACCOUNT_REGISTRATION_ENABLED=true

# Public one-hour demo-token issuance is open unless explicitly closed.
PUBLIC_DEMO_ENABLED=true

# Replace this synthetic setup value before creating the first administrator.
# It is ignored permanently after the first account exists.
ACCOUNT_BOOTSTRAP_TOKEN=replace-with-a-random-32-byte-bootstrap-secret

# Production must use the public HTTPS origin. Loopback HTTP is for development.
APP_ORIGIN=http://localhost:3000

# Optional comma-separated hostnames accepted by the Vite development server.
# Keep machine-specific Tailscale hostnames in the uncommitted .env file.
__VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=
