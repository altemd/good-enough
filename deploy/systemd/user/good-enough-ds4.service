[Unit]
Description=Good Enough ds4 inference backend
After=network-online.target
PartOf=good-enough-ds4.target
StartLimitIntervalSec=120
StartLimitBurst=2

[Service]
Type=simple
WorkingDirectory=%h/Projects/good-enough
EnvironmentFile=%h/Projects/good-enough/.env.ds4
ExecStartPre=/usr/bin/test -r %h/Projects/good-enough/.env.ds4
ExecStartPre=/usr/bin/test -r ${DS4_MODEL_PATH}
ExecStart=/usr/bin/toolbox run --container ds4-rocm-7.14 ds4-server -m ${DS4_MODEL_PATH} --ctx 64000 --prefill-chunk 2048 --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
KillMode=control-group
OOMPolicy=stop
Delegate=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=good-enough-ds4
